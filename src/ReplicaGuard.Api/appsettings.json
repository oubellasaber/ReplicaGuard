{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "__SET_IN_USER_SECRETS__",
    "Issuer": "ReplicaGuard",
    "Audience": "ReplicaGuard.Api",
    "ExpirationInMinutes": 1500,
    "RefreshTokenExpirationInDays": 7
  },
  "Messaging": {
    "QueryDelayInSeconds": 500,
    "DuplicateDetectionWindowInMinutes": 500
  },
  "Storage": {
    "MaxFileSizeBytes": 10737418240,
    "MaxConcurrentDownloads": 3,
    "MinFreeBytes": 104857600,
    "RetentionDays": 7,
    "CleanupIntervalMinutes": 30
  },
  "ExpirationRefresh": {
    "IntervalMinutes": 360,
    "ScanWindowDays": 3,
    "ExpiringSoonThresholdDays": 1,
    "BatchSize": 10,
    "RecoveryBackoffBaseMinutes": 720
  },
  "Hosters": {
    "DefaultUserAgent": "ReplicaGuard/0.1",
    "SendCm": {
      "ApiBaseUrl": "https://send.now",
      "UserInfoEndpoint": "https://send.now/api/user/info",
      "UploadServerEndpoint": "https://send.now/api/upload/server",
      "RenameFileEndpoint": "https://send.now/api/file/rename",
      "FileCloneEndpoint": "https://send.now/api/file/clone",
      "FileInfoEndpoint": "https://send.now/api/file/info"
    },
    "Pixeldrain": {
      "ApiBaseUrl": "https://pixeldrain.com",
      "UserInfoEndpoint": "https://pixeldrain.com/api/user",
      "FileUploadEndpoint": "https://pixeldrain.com/api/file",
      "FileUrlBase": "https://pixeldrain.com/u"
    }
  }
}
